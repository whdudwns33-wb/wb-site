 "words": [
  {
   "unit": "u03",
   "word": "관측",
   "meaning": "눈이나 기계로 자연 현상을 자세히 살펴 재는 것",
   "hanja": "觀(볼 관)+測(잴 측)",
   "example": "천문대에서 별의 움직임을 관측했다."
  },
  {
   "unit": "u03",
   "word": "관점",
   "meaning": "사물이나 일을 바라보는 자기만의 자리",
   "hanja": "觀(볼 관)+點(점 점)",
   "example": "같은 일도 관점에 따라 다르게 보인다."
  },
  {
   "unit": "u03",
   "word": "객관",
   "meaning": "내 감정에서 떨어져 남의 눈으로 보듯 보는 것",
   "hanja": "客(손님 객)+觀(볼 관)",
   "example": "심판은 객관적인 눈으로 판정해야 한다."
  },
  {
   "unit": "u03",
   "word": "주관",
   "meaning": "자기 생각과 느낌을 중심으로 보는 것",
   "hanja": "主(주인 주)+觀(볼 관)",
   "example": "일기에는 나의 주관이 그대로 담긴다."
  },
  {
   "unit": "u03",
   "word": "관찰",
   "meaning": "눈여겨 자세히 살펴봄",
   "hanja": "觀(볼 관)+察(살필 찰)",
   "example": "개미의 움직임을 한 시간 동안 관찰했다."
  },
  {
   "unit": "u03",
   "word": "추론",
   "meaning": "아는 사실을 바탕으로 모르는 것을 미루어 생각함",
   "hanja": "推(밀 추)+論(논할 론)",
   "example": "발자국 크기로 범인의 키를 추론했다."
  },
  {
   "unit": "u03",
   "word": "전제",
   "meaning": "어떤 주장이 성립하도록 미리 깔아 두는 조건",
   "hanja": "前(앞 전)+提(끌 제)",
   "example": "약속은 지킨다는 전제 위에서 이루어진다."
  },
  {
   "unit": "u03",
   "word": "반론",
   "meaning": "상대의 주장에 맞서 되받아치는 주장",
   "hanja": "反(돌이킬 반)+論(논할 론)",
   "example": "토론에서 상대의 반론에 침착하게 답했다."
  },
  {
   "unit": "u03",
   "word": "논증",
   "meaning": "이유와 증거를 들어 주장이 옳음을 밝힘",
   "hanja": "論(논할 론)+證(증거 증)",
   "example": "글쓴이는 세 가지 근거로 주장을 논증했다."
  },
  {
   "unit": "u03",
   "word": "타당",
   "meaning": "이치에 맞아 옳다고 할 만함",
   "hanja": "妥(온당할 타)+當(마땅 당)",
   "example": "그 주장은 근거가 충분해서 타당하다."
  },
  {
