# 그림검사 백엔드 환경변수 예시
# 이 파일은 '예시'입니다. 실제 값이 든 .env 는 절대 커밋하지 마세요(.gitignore 처리됨).

# ── AI (필수: 실제 해석을 돌릴 때) ────────────────────────────────
# 비워 두면 mock 모드로 동작합니다(API 호출·비용 없음, 흐름 검증용).
ANTHROPIC_API_KEY=

# 단계별 모델 (미지정 시 claude-opus-5)
# S1=관찰 추출(Vision), S3=자연어 생성
MODEL_S1=claude-opus-5
MODEL_S3=claude-opus-5

# ── 서버 ─────────────────────────────────────────────────────────
PORT=8787

# 브라우저에서 호출을 허용할 출처. 운영에서는 '*' 금지 — 실제 도메인만.
# 예) https://whdudwns33-wb.github.io
CORS_ORIGIN=*
