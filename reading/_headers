# 보안 헤더는 전 경로에 공통으로. style-src 에 'self' 이 있어야 브레인레터 글꼴 목록(/letter/fonts/fonts.css)처럼
# 같은 오리진의 외부 스타일시트가 열린다 — 'unsafe-inline' 만으로는 <link rel=stylesheet> 가 막힌다(운영에서만 보이는 차이다).
# Cache-Control 은 여기 두지 않는다 —
# /* 에 no-store 를 두면 아래 개별 규칙과 합쳐져 "no-store, public, max-age=..." 가 되고
# 브라우저는 더 엄격한 쪽(no-store)을 따라 캐시가 통째로 무력화된다.
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex, nofollow, noarchive
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# 화면과 관리용 데이터는 항상 최신이어야 한다
/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store
/review.html
  Cache-Control: no-store
/parent.html
  Cache-Control: no-store
/sw.js
  Cache-Control: no-store
/articles.json
  Cache-Control: no-store
/version.json
  Cache-Control: no-store

# 내신 앱 셸 — 앱 디렉터리별 _headers 는 빌드가 복사하지 않고 워커도 읽지 않는다.
# 학습 화면과 서비스 워커는 항상 최신이어야 하므로 여기에 규칙을 둔다.
# (팩 콘텐츠는 정적 자산이 아니라 /api/*로만 나가고, 거기엔 json() 헬퍼가 no-store를 붙인다.)
/naesin/
  Cache-Control: no-store
/naesin/index.html
  Cache-Control: no-store
/naesin/sw.js
  Cache-Control: no-store
/naesin-ko/
  Cache-Control: no-store
/naesin-ko/index.html
  Cache-Control: no-store
/naesin-ko/sw.js
  Cache-Control: no-store
/letter/
  Cache-Control: no-store
/letter/index.html
  Cache-Control: no-store
/letter/sw.js
  Cache-Control: no-store

# 학년대별 지문은 URL에 ?v=<버전>을 달고 받는다. 내용이 바뀌면 버전이 바뀌므로
# 오래 캐시해도 안전하고, 그래야 앱을 켤 때마다 다시 받지 않는다.
/articles-L1.json
  Cache-Control: public, max-age=604800
/articles-L2.json
  Cache-Control: public, max-age=604800
/articles-L3.json
  Cache-Control: public, max-age=604800
/articles-L4.json
  Cache-Control: public, max-age=604800
/hanja.json
  Cache-Control: public, max-age=604800

# 세 앱과 관리 웹의 화면·코드는 항상 최신이어야 한다 — 배포본(dist)에 실리는 _headers 는 이 파일 하나다.
# naesin/_headers·vocab/_headers·haru/_headers·hanja/_headers 는 dist 에 실리지 않으니 규칙은 여기에만 둔다.
# noindex·CSP 등 보안 헤더는 맨 위 /* 가 이미 전 경로에 붙인다(여기 다시 적으면 값이 겹쳐 붙는다).
/naesin/*
  Cache-Control: no-store
/vocab/*
  Cache-Control: no-store
/haru/*
  Cache-Control: no-store
/hanja/*
  Cache-Control: no-store
/chunk/*
  Cache-Control: no-store
/letter/*
  Cache-Control: no-store
/admin/*
  Cache-Control: no-store
